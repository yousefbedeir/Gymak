<div class="sidebar-container d-flex flex-column h-100">
    <!-- Brand Header -->
    <div class="brand-header px-4 d-flex align-items-center justify-content-between"
         style="border-bottom: 1px solid rgba(255,255,255,0.07); min-height: 64px;">
        <a class="d-flex align-items-center gap-3 text-decoration-none" href="">
            <div class="brand-icon">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div>
                <span class="fw-bold text-white d-block" style="font-size: 1.15rem; letter-spacing: -0.3px;">GYMAK</span>
                <span class="fw-semibold text-uppercase d-block" style="font-size: 0.6rem; letter-spacing: 2px; color: #1e5adc;">FITNESS OS</span>
            </div>
        </a>
        <button class="d-md-none text-white border-0 p-1 rounded"
                style="background: rgba(255,255,255,0.05);" type="button" @onclick="ToggleNavMenu">
            <i class="bi bi-list fs-4"></i>
        </button>
    </div>

    <!-- Navigation List -->
    <div class="nav-scrollable flex-grow-1 px-3 py-3 @(collapseNavMenu ? "collapse" : "")">

        <div class="nav-section-title px-2 mb-2 text-uppercase font-monospace"
             style="font-size: 0.62rem; letter-spacing: 2px; color: #374151;">
            Main Menu
        </div>

        <nav class="nav flex-column gap-1 mb-3">
            <div class="nav-item">
                <NavLink class="nav-link-custom d-flex align-items-center gap-3" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-grid-fill nav-icon"></i>
                    <span>Dashboard</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link-custom d-flex align-items-center gap-3" href="members">
                    <i class="bi bi-people-fill nav-icon"></i>
                    <span>Members</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link-custom d-flex align-items-center gap-3" href="workouts">
                    <i class="bi bi-activity nav-icon"></i>
                    <span>Workouts</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link-custom d-flex align-items-center gap-3" href="nutrition">
                    <i class="bi bi-egg-fried nav-icon"></i>
                    <span>Diet & Nutrition</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link-custom d-flex align-items-center gap-3" href="subscriptions">
                    <i class="bi bi-credit-card-fill nav-icon"></i>
                    <span>Subscriptions</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link-custom d-flex align-items-center gap-3" href="progress-logs">
                    <i class="bi bi-graph-up nav-icon"></i>
                    <span>Progress</span>
                </NavLink>
            </div>
        </nav>

        <div class="mb-2" style="border-top: 1px solid rgba(255,255,255,0.05);"></div>

        <div class="nav-section-title px-2 mb-2 mt-3 text-uppercase font-monospace"
             style="font-size: 0.62rem; letter-spacing: 2px; color: #374151;">
            System
        </div>

        <nav class="nav flex-column gap-1">
            <div class="nav-item">
                <NavLink class="nav-link-custom d-flex align-items-center gap-3" href="users">
                    <i class="bi bi-shield-check nav-icon"></i>
                    <span>User Management</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link-custom d-flex align-items-center gap-3" href="profile">
                    <i class="bi bi-person-circle nav-icon"></i>
                    <span>My Profile</span>
                </NavLink>
            </div>
        </nav>
    </div>

    <!-- Footer -->
    <div class="p-3" style="border-top: 1px solid rgba(255,255,255,0.07);">
        <AuthorizeView>
            <Authorized>
                <a href="profile" class="d-flex align-items-center gap-2 p-2 rounded text-decoration-none"
                   style="background: rgba(30,90,220,0.1); border: 1px solid rgba(30,90,220,0.25); transition: all 0.2s;">
                    <div class="d-flex align-items-center justify-content-center fw-bold text-white rounded flex-shrink-0"
                         style="width: 36px; height: 36px; background: #1e5adc; font-size: 0.78rem;">
                        @GetInitials(context.User.Identity?.Name)
                    </div>
                    <div class="overflow-hidden me-auto">
                        <span class="d-block text-white fw-semibold text-truncate" style="font-size: 0.82rem;">@(context.User.Identity?.Name ?? "My Account")</span>
                        <span class="d-block" style="font-size: 0.68rem; color: #22c55e;">
                            <i class="bi bi-circle-fill me-1" style="font-size: 0.4rem;"></i>Active
                        </span>
                    </div>
                    <i class="bi bi-chevron-right" style="font-size: 0.8rem; color: #4b5563;"></i>
                </a>
            </Authorized>
            <NotAuthorized>
                <div class="d-flex flex-column gap-2">
                    <a href="login" class="btn btn-sm fw-semibold rounded w-100"
                       style="background: transparent; border: 1px solid rgba(30,90,220,0.5); color: #3b7ff5;">
                        Sign In
                    </a>
                    <a href="register" class="btn btn-sm fw-bold rounded w-100"
                       style="background: #1e5adc; color: white; border: none;">
                        Create Account
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "U";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return (parts[0][..1] + parts[^1][..1]).ToUpper();
    }
}
