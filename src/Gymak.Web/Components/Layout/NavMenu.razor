<div class="sidebar-container d-flex flex-column h-100">
    <!-- Brand Header -->
    <div class="brand-header px-4 py-3 border-bottom border-secondary border-opacity-10 d-flex align-items-center justify-content-between">
        <a class="d-flex align-items-center text-decoration-none" href="">
            <div class="brand-icon me-3">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div>
                <span class="brand-title fw-bold fs-5 text-white d-block">GYMAK</span>
                <span class="brand-subtitle text-primary text-uppercase fw-semibold" style="font-size: 0.65rem; letter-spacing: 1.5px;">Fitness OS</span>
            </div>
        </a>
        <button class="navbar-toggler d-md-none text-white border-0 bg-transparent" type="button" @onclick="ToggleNavMenu">
            <i class="bi bi-list fs-3"></i>
        </button>
    </div>

    <!-- Navigation List -->
    <div class="nav-scrollable flex-grow-1 px-3 py-4 @(collapseNavMenu ? "collapse" : "")">
        <div class="nav-section-title px-3 mb-2 text-uppercase text-muted font-monospace" style="font-size: 0.7rem; letter-spacing: 1px;">
            Main Navigation
        </div>

        <nav class="nav flex-column gap-1">
            <div class="nav-item">
                <NavLink class="nav-link-custom d-flex align-items-center" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-grid-1x2-fill nav-icon me-3"></i>
                    <span>Dashboard</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link-custom d-flex align-items-center" href="members">
                    <i class="bi bi-people-fill nav-icon me-3"></i>
                    <span>Users & Members</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link-custom d-flex align-items-center" href="workouts">
                    <i class="bi bi-capslock-fill nav-icon me-3"></i>
                    <span>Workouts & Exercises</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link-custom d-flex align-items-center" href="nutrition">
                    <i class="bi bi-heart-pulse-fill nav-icon me-3"></i>
                    <span>Diet & Nutrition</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link-custom d-flex align-items-center" href="subscriptions">
                    <i class="bi bi-credit-card-2-front-fill nav-icon me-3"></i>
                    <span>Subscriptions</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link-custom d-flex align-items-center" href="progress-logs">
                    <i class="bi bi-graph-up-arrow nav-icon me-3"></i>
                    <span>Progress & Metrics</span>
                </NavLink>
            </div>
        </nav>
    </div>

    <!-- Footer Profile Info -->
    <div class="sidebar-footer p-3 border-top border-secondary border-opacity-10">
        <AuthorizeView>
            <Authorized>
                <a href="profile" class="d-flex align-items-center p-2 rounded-3 bg-dark bg-opacity-50 text-decoration-none text-white hover-bg-light transition">
                    <div class="avatar me-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 38px; height: 38px;">
                        @GetInitials(context.User.Identity?.Name)
                    </div>
                    <div class="overflow-hidden me-auto">
                        <span class="d-block text-white fw-semibold text-truncate" style="font-size: 0.85rem;">@(context.User.Identity?.Name ?? "User Profile")</span>
                        <span class="d-block text-success small" style="font-size: 0.75rem;"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Authenticated</span>
                    </div>
                    <i class="bi bi-gear-fill text-muted ms-2"></i>
                </a>
            </Authorized>
            <NotAuthorized>
                <div class="d-flex flex-column gap-2">
                    <a href="login" class="btn btn-outline-primary btn-sm w-100 fw-semibold">Sign In</a>
                    <a href="register" class="btn btn-primary btn-sm w-100 fw-semibold">Register</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "U";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return (parts[0][..1] + parts[^1][..1]).ToUpper();
    }
}
