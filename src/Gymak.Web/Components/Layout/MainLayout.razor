@inherits LayoutComponentBase

<div class="page-wrapper d-flex flex-column flex-md-row min-vh-100">
    <!-- Sidebar -->
    <aside class="sidebar-wrapper flex-shrink-0">
        <NavMenu />
    </aside>

    <!-- Main Content Area -->
    <div class="main-wrapper flex-grow-1 d-flex flex-column">
        <!-- Top Header -->
        <header class="top-header px-4 d-flex align-items-center justify-content-between">
            <!-- Left: Page Title / Search -->
            <div class="d-flex align-items-center gap-3">
                <div class="search-box position-relative d-none d-sm-flex align-items-center" style="width: 240px;">
                    <i class="bi bi-search position-absolute ms-3 text-muted" style="font-size: 0.8rem;"></i>
                    <input type="text" class="form-control form-control-dark ps-5" placeholder="Search..." />
                </div>
            </div>

            <!-- Right: Status & User -->
            <div class="d-flex align-items-center gap-2">
                <!-- DB Status -->
                <div class="d-none d-md-flex align-items-center gap-2 px-3 py-1 rounded"
                     style="background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.2); font-size: 0.78rem;">
                    <span style="width: 7px; height: 7px; border-radius: 50%; background: #22c55e; display: inline-block;"></span>
                    <span style="color: #6b7280;">Database</span>
                    <span class="fw-semibold text-white">Connected</span>
                </div>

                <!-- Auth Actions -->
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex align-items-center gap-2">
                            <!-- User Pill -->
                            <a href="profile" class="d-flex align-items-center gap-2 px-3 py-1 rounded text-decoration-none"
                               style="background: #1e1e1e; border: 1px solid rgba(255,255,255,0.1); font-size: 0.82rem; transition: border-color 0.2s;">
                                <div class="d-flex align-items-center justify-content-center fw-bold text-white rounded flex-shrink-0"
                                     style="width: 26px; height: 26px; background: #1e5adc; font-size: 0.7rem;">
                                    @GetInitials(context.User.Identity?.Name)
                                </div>
                                <span class="fw-semibold text-white d-none d-md-block">@context.User.Identity?.Name</span>
                            </a>
                            <!-- Logout -->
                            <button class="d-flex align-items-center justify-content-center rounded border-0"
                                    style="width: 34px; height: 34px; background: rgba(239,68,68,0.1); color: #ef4444; transition: background 0.2s;"
                                    title="Sign Out" @onclick="HandleLogout">
                                <i class="bi bi-power" style="font-size: 0.9rem;"></i>
                            </button>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="d-flex align-items-center gap-2">
                            <a href="login" class="btn btn-sm fw-semibold rounded px-3"
                               style="background: transparent; border: 1px solid rgba(30,90,220,0.5); color: #3b7ff5;">Sign In</a>
                            <a href="register" class="btn btn-sm fw-bold rounded px-3"
                               style="background: #1e5adc; color: white; border: none;">Register</a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <!-- Main Body -->
        <main class="content-wrapper flex-grow-1 p-4">
            @Body
        </main>

        <!-- Footer -->
        <footer class="footer px-4 py-3 d-flex justify-content-between align-items-center">
            <span>© 2026 GYMAK. All rights reserved.</span>
            <span>Powered by .NET 9 & EF Core</span>
        </footer>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@using Gymak.Web.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

@code {
    private async Task HandleLogout()
    {
        if (AuthStateProvider is CustomAuthenticationStateProvider customAuthStateProvider)
        {
            await customAuthStateProvider.MarkUserAsLoggedOut();
        }
        NavigationManager.NavigateTo("login");
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "U";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return (parts[0][..1] + parts[^1][..1]).ToUpper();
    }
}
