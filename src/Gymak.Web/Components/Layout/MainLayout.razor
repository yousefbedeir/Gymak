@inherits LayoutComponentBase

<div class="page-wrapper d-flex flex-column flex-md-row min-vh-100">
    <!-- Sidebar -->
    <aside class="sidebar-wrapper flex-shrink-0">
        <NavMenu />
    </aside>

    <!-- Main Content Area -->
    <div class="main-wrapper flex-grow-1 d-flex flex-column">
        <!-- Top Navbar -->
        <header class="top-header px-4 py-3 border-bottom border-secondary border-opacity-10 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="search-box position-relative d-none d-sm-block" style="width: 280px;">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" class="form-control form-control-dark ps-5 py-2" placeholder="Search members, plans..." style="font-size: 0.85rem;" />
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="d-none d-md-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-dark bg-opacity-50 border border-secondary border-opacity-10" style="font-size: 0.8rem;">
                    <span class="badge bg-success rounded-circle p-1 me-1"><span class="visually-hidden">Online</span></span>
                    <span class="text-muted">System Status:</span>
                    <span class="text-white fw-semibold">SQL Server Connected</span>
                </div>

                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex align-items-center gap-2">
                            <a href="profile" class="btn btn-dark bg-opacity-50 border border-secondary border-opacity-10 text-white rounded-pill px-3 py-1.5 btn-sm d-flex align-items-center gap-2 text-decoration-none">
                                <i class="bi bi-person-circle text-primary"></i>
                                <span class="fw-semibold" style="font-size: 0.85rem;">@context.User.Identity?.Name</span>
                            </a>
                            <button class="btn btn-outline-danger border-opacity-20 rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" title="Sign Out" @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="d-flex align-items-center gap-2">
                            <a href="login" class="btn btn-outline-primary btn-sm rounded-pill px-3">Sign In</a>
                            <a href="register" class="btn btn-primary btn-sm rounded-pill px-3">Register</a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <!-- Main Body View -->
        <main class="content-wrapper flex-grow-1 p-4">
            @Body
        </main>

        <!-- Footer -->
        <footer class="footer border-top border-secondary border-opacity-10 px-4 py-3 text-muted d-flex justify-content-between align-items-center" style="font-size: 0.8rem;">
            <span>&copy; 2026 Gymak Fitness OS. All rights reserved.</span>
            <span>Powered by .NET 9 & EF Core</span>
        </footer>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@using Gymak.Web.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

@code {
    private async Task HandleLogout()
    {
        if (AuthStateProvider is CustomAuthenticationStateProvider customAuthStateProvider)
        {
            await customAuthStateProvider.MarkUserAsLoggedOut();
        }
        NavigationManager.NavigateTo("login");
    }
}
