@page "/login"
@using Gymak.Application.DTOs
@using Gymak.Application.Services
@using Gymak.Web.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Login - Gymak Fitness OS</PageTitle>

<div class="login-wrapper d-flex align-items-center justify-content-center min-vh-100 py-5" style="background: radial-gradient(circle at top right, #1e293b, #0f172a);">
    <div class="card border-0 shadow-lg p-4 p-md-5 rounded-4 text-white" style="max-width: 440px; width: 100%; background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.1);">
        
        <!-- Header / Logo -->
        <div class="text-center mb-4">
            <div class="brand-icon mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-primary bg-gradient text-white" style="width: 60px; height: 60px; box-shadow: 0 0 20px rgba(14, 165, 233, 0.4);">
                <i class="bi bi-lightning-charge-fill fs-2"></i>
            </div>
            <h3 class="fw-bold tracking-tight mb-1">Welcome Back</h3>
            <p class="text-muted small">Sign in to your Gymak Fitness OS account</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 rounded-3 small mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>@errorMessage</div>
            </div>
        }

        <EditForm Model="loginInput" OnValidSubmit="HandleLogin" FormName="LoginForm">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="email" class="form-label text-white-50 small fw-medium">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text border-0 bg-dark text-muted"><i class="bi bi-envelope"></i></span>
                    <input id="email" type="email" class="form-control bg-dark border-0 text-white shadow-none" placeholder="name@gymak.com" @bind="loginInput.Email" required />
                </div>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label for="password" class="form-label text-white-50 small fw-medium mb-0">Password</label>
                    <a href="forgot-password" class="text-primary text-decoration-none small">Forgot Password?</a>
                </div>
                <div class="input-group">
                    <span class="input-group-text border-0 bg-dark text-muted"><i class="bi bi-lock"></i></span>
                    <input id="password" type="password" class="form-control bg-dark border-0 text-white shadow-none" placeholder="••••••••" @bind="loginInput.Password" required />
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2.5 fw-semibold rounded-3 mt-3 d-flex align-items-center justify-content-center gap-2" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Signing in...</span>
                }
                else
                {
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Sign In</span>
                }
            </button>
        </EditForm>

        <!-- Quick Demo Credentials -->
        <div class="mt-4 p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-10 small">
            <div class="text-uppercase font-monospace text-muted mb-2" style="font-size: 0.65rem; letter-spacing: 1px;">Demo Accounts</div>
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge bg-danger bg-opacity-20 text-danger">Admin</span>
                <code class="text-info cursor-pointer" @onclick='() => FillCredentials("admin@gymak.com", "Admin123!")'>admin@gymak.com</code>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge bg-warning bg-opacity-20 text-warning">Trainer</span>
                <code class="text-info cursor-pointer" @onclick='() => FillCredentials("trainer@gymak.com", "Trainer123!")'>trainer@gymak.com</code>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <span class="badge bg-success bg-opacity-20 text-success">Member</span>
                <code class="text-info cursor-pointer" @onclick='() => FillCredentials("member@gymak.com", "Member123!")'>member@gymak.com</code>
            </div>
        </div>

        <div class="text-center mt-4">
            <span class="text-muted small">Don't have an account? </span>
            <a href="register" class="text-primary fw-semibold text-decoration-none small">Create an account</a>
        </div>
    </div>
</div>

@code {
    private LoginModelInput loginInput = new();
    private string? errorMessage;
    private bool isLoading;

    private class LoginModelInput
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private void FillCredentials(string email, string password)
    {
        loginInput.Email = email;
        loginInput.Password = password;
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var req = new LoginRequest(loginInput.Email, loginInput.Password);
            var result = await AuthService.LoginAsync(req);

            if (result.Succeeded && result.User != null)
            {
                if (AuthStateProvider is CustomAuthenticationStateProvider customAuthStateProvider)
                {
                    await customAuthStateProvider.MarkUserAsAuthenticated(result.User);
                }

                NavigationManager.NavigateTo("");
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Login failed. Please check your credentials.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
