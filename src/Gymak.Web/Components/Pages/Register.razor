@page "/register"
@using Gymak.Application.DTOs
@using Gymak.Application.Services
@using Gymak.Web.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Register - Gymak Fitness OS</PageTitle>

<div class="register-wrapper d-flex align-items-center justify-content-center min-vh-100 py-5" style="background: radial-gradient(circle at top right, #1e293b, #0f172a);">
    <div class="card border-0 shadow-lg p-4 p-md-5 rounded-4 text-white" style="max-width: 480px; width: 100%; background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.1);">
        
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="brand-icon mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-primary bg-gradient text-white" style="width: 60px; height: 60px; box-shadow: 0 0 20px rgba(14, 165, 233, 0.4);">
                <i class="bi bi-person-plus-fill fs-2"></i>
            </div>
            <h3 class="fw-bold tracking-tight mb-1">Create Account</h3>
            <p class="text-muted small">Join Gymak Fitness OS and track your workout & diet goals</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 rounded-3 small mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>@errorMessage</div>
            </div>
        }

        <EditForm Model="registerModel" OnValidSubmit="HandleRegister" FormName="RegisterForm">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="fullName" class="form-label text-white-50 small fw-medium">Full Name</label>
                <div class="input-group">
                    <span class="input-group-text border-0 bg-dark text-muted"><i class="bi bi-person"></i></span>
                    <input id="fullName" type="text" class="form-control bg-dark border-0 text-white shadow-none" placeholder="John Doe" @bind="registerModel.FullName" required />
                </div>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label text-white-50 small fw-medium">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text border-0 bg-dark text-muted"><i class="bi bi-envelope"></i></span>
                    <input id="email" type="email" class="form-control bg-dark border-0 text-white shadow-none" placeholder="john@example.com" @bind="registerModel.Email" required />
                </div>
            </div>

            <div class="mb-3">
                <label for="phone" class="form-label text-white-50 small fw-medium">Phone Number (Optional)</label>
                <div class="input-group">
                    <span class="input-group-text border-0 bg-dark text-muted"><i class="bi bi-telephone"></i></span>
                    <input id="phone" type="tel" class="form-control bg-dark border-0 text-white shadow-none" placeholder="+201..." @bind="registerModel.PhoneNumber" />
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label for="password" class="form-label text-white-50 small fw-medium">Password</label>
                    <div class="input-group">
                        <span class="input-group-text border-0 bg-dark text-muted"><i class="bi bi-lock"></i></span>
                        <input id="password" type="password" class="form-control bg-dark border-0 text-white shadow-none" placeholder="••••••••" @bind="registerModel.Password" required />
                    </div>
                </div>
                <div class="col-6">
                    <label for="confirmPassword" class="form-label text-white-50 small fw-medium">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text border-0 bg-dark text-muted"><i class="bi bi-shield-check"></i></span>
                        <input id="confirmPassword" type="password" class="form-control bg-dark border-0 text-white shadow-none" placeholder="••••••••" @bind="registerModel.ConfirmPassword" required />
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2.5 fw-semibold rounded-3 mt-3 d-flex align-items-center justify-content-center gap-2" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Creating account...</span>
                }
                else
                {
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Register Now</span>
                }
            </button>
        </EditForm>

        <div class="text-center mt-4">
            <span class="text-muted small">Already have an account? </span>
            <a href="login" class="text-primary fw-semibold text-decoration-none small">Sign in</a>
        </div>
    </div>
</div>

@code {
    private RegisterInput registerModel = new();
    private string? errorMessage;
    private bool isLoading;

    private class RegisterInput
    {
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
        public string? PhoneNumber { get; set; }
    }

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var req = new RegisterRequest(
                registerModel.FullName,
                registerModel.Email,
                registerModel.Password,
                registerModel.ConfirmPassword,
                registerModel.PhoneNumber
            );

            var result = await AuthService.RegisterAsync(req);

            if (result.Succeeded && result.User != null)
            {
                if (AuthStateProvider is CustomAuthenticationStateProvider customAuthStateProvider)
                {
                    await customAuthStateProvider.MarkUserAsAuthenticated(result.User);
                }

                NavigationManager.NavigateTo("");
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Registration failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred during registration: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
