@page "/register"
@layout Layout.AuthLayout
@using Gymak.Application.DTOs
@using Gymak.Application.Services
@using Gymak.Web.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Create Account - GYMAK</PageTitle>

<div class="d-flex align-items-center justify-content-center min-vh-100 anim-fade" style="background: #080808;">
    <div class="anim-fade-up" style="width: 100%; max-width: 460px; padding: 1.5rem;">

        <!-- Brand -->
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded mb-3"
                 style="width: 56px; height: 56px; background: #f5c518; box-shadow: 0 4px 20px rgba(245,197,24,0.25);">
                <i class="bi bi-person-plus-fill text-black fs-2"></i>
            </div>
            <h2 class="fw-bold text-white mb-1" style="font-family: 'Bebas Neue', sans-serif; font-size: 2.2rem; letter-spacing: 2px;">CREATE ACCOUNT</h2>
            <p style="color: #6b7280; font-size: 0.85rem;">JOIN GYMAK TODAY</p>
        </div>

        <!-- Card -->
        <div class="p-4" style="background: #111111; border: 1px solid rgba(255,255,255,0.08); border-radius: 0.5rem; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="d-flex align-items-center gap-2 p-3 rounded mb-3"
                     style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #ef4444; font-size: 0.85rem;">
                    <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
                    <span>@errorMessage</span>
                </div>
            }

            <EditForm Model="registerModel" OnValidSubmit="HandleRegister" FormName="RegisterForm">
                <DataAnnotationsValidator />

                <!-- Full Name -->
                <div class="mb-3">
                    <label class="d-block mb-1" style="color: #9ca3af; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Full Name</label>
                    <div class="d-flex align-items-center rounded" style="background: #181818; border: 1px solid rgba(255,255,255,0.1); overflow: hidden;">
                        <span class="px-3" style="color: #6b7280;"><i class="bi bi-person"></i></span>
                        <input id="fullName" type="text" class="flex-grow-1 border-0 text-white bg-transparent py-2 pe-3"
                               style="outline: none; font-size: 0.88rem;" placeholder="John Doe" @bind="registerModel.FullName" required />
                    </div>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label class="d-block mb-1" style="color: #9ca3af; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Email Address</label>
                    <div class="d-flex align-items-center rounded" style="background: #181818; border: 1px solid rgba(255,255,255,0.1); overflow: hidden;">
                        <span class="px-3" style="color: #6b7280;"><i class="bi bi-envelope"></i></span>
                        <input id="email" type="email" class="flex-grow-1 border-0 text-white bg-transparent py-2 pe-3"
                               style="outline: none; font-size: 0.88rem;" placeholder="john@example.com" @bind="registerModel.Email" required />
                    </div>
                </div>

                <!-- Phone -->
                <div class="mb-3">
                    <label class="d-block mb-1" style="color: #9ca3af; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Phone <span style="color:#4b5563;">(Optional)</span></label>
                    <div class="d-flex align-items-center rounded" style="background: #181818; border: 1px solid rgba(255,255,255,0.1); overflow: hidden;">
                        <span class="px-3" style="color: #6b7280;"><i class="bi bi-telephone"></i></span>
                        <input id="phone" type="tel" class="flex-grow-1 border-0 text-white bg-transparent py-2 pe-3"
                               style="outline: none; font-size: 0.88rem;" placeholder="+201..." @bind="registerModel.PhoneNumber" />
                    </div>
                </div>

                <!-- Passwords -->
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <label class="d-block mb-1" style="color: #9ca3af; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Password</label>
                        <div class="d-flex align-items-center rounded" style="background: #181818; border: 1px solid rgba(255,255,255,0.1); overflow: hidden;">
                            <span class="px-3" style="color: #6b7280;"><i class="bi bi-lock"></i></span>
                            <input id="password" type="password" class="flex-grow-1 border-0 text-white bg-transparent py-2 pe-2"
                                   style="outline: none; font-size: 0.88rem;" placeholder="••••••••" @bind="registerModel.Password" required />
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="d-block mb-1" style="color: #9ca3af; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Confirm</label>
                        <div class="d-flex align-items-center rounded" style="background: #181818; border: 1px solid rgba(255,255,255,0.1); overflow: hidden;">
                            <span class="px-3" style="color: #6b7280;"><i class="bi bi-shield-check"></i></span>
                            <input id="confirmPassword" type="password" class="flex-grow-1 border-0 text-white bg-transparent py-2 pe-2"
                                   style="outline: none; font-size: 0.88rem;" placeholder="••••••••" @bind="registerModel.ConfirmPassword" required />
                        </div>
                    </div>
                </div>

                <button type="submit" class="w-100 border-0 rounded py-2.5 fw-bold text-black d-flex align-items-center justify-content-center gap-2"
                        style="background: #f5c518; font-size: 0.88rem; letter-spacing: 1px; cursor: pointer; transition: all 0.2s;" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>CREATING ACCOUNT...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle-fill"></i>
                        <span>CREATE ACCOUNT</span>
                    }
                </button>
            </EditForm>
        </div>

        <p class="text-center mt-3" style="color: #6b7280; font-size: 0.85rem;">
            Already have an account?
            <a href="login" style="color: #f5c518; font-weight: 700;">Sign in</a>
        </p>
    </div>
</div>

@code {
    private RegisterInput registerModel = new();
    private string? errorMessage;
    private bool isLoading;

    private class RegisterInput
    {
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
        public string? PhoneNumber { get; set; }
    }

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var req = new RegisterRequest(registerModel.FullName, registerModel.Email, registerModel.Password, registerModel.ConfirmPassword, registerModel.PhoneNumber);
            var result = await AuthService.RegisterAsync(req);
            if (result.Succeeded && result.User != null)
            {
                if (AuthStateProvider is CustomAuthenticationStateProvider customAuthStateProvider)
                    await customAuthStateProvider.MarkUserAsAuthenticated(result.User);
                NavigationManager.NavigateTo("");
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Registration failed. Please try again.";
            }
        }
        catch (Exception ex) { errorMessage = "An error occurred: " + ex.Message; }
        finally { isLoading = false; }
    }
}
