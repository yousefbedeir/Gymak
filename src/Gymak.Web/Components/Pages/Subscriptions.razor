@page "/subscriptions"
@using Gymak.Application.Services
@using Gymak.Application.DTOs
@using Gymak.Domain.Enums
@inject ISubscriptionService SubscriptionService
@inject IPaymentService PaymentService
@inject IUserService UserService
@rendermode InteractiveServer

<PageTitle>Subscriptions & Financials - Gymak</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-card-checklist text-primary me-2"></i>Subscriptions & Financials</h2>
            <p class="text-muted mb-0">Manage membership plans, active subscriptions, and payment transactions.</p>
        </div>
    </div>

    <!-- Nav Tabs -->
    <ul class="nav nav-tabs mb-4" id="subTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "plans" ? "active fw-bold" : "")" @onclick='() => activeTab = "plans"'>
                <i class="bi bi-tags me-1"></i> Subscription Plans
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "subscriptions" ? "active fw-bold" : "")" @onclick='() => activeTab = "subscriptions"'>
                <i class="bi bi-person-badge me-1"></i> Active Subscriptions
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "payments" ? "active fw-bold" : "")" @onclick='() => activeTab = "payments"'>
                <i class="bi bi-currency-dollar me-1"></i> Payments & Revenue
            </button>
        </li>
    </ul>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        @if (activeTab == "plans")
        {
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-header bg-primary text-white py-3">
                            <h5 class="card-title mb-0 fw-semibold"><i class="bi bi-plus-circle me-2"></i>Create Plan</h5>
                        </div>
                        <div class="card-body">
                            <EditForm Model="newPlan" OnValidSubmit="HandleCreatePlan">
                                <DataAnnotationsValidator />
                                <div class="mb-3">
                                    <label class="form-label font-monospace small text-muted">Plan Name</label>
                                    <InputText class="form-control" @bind-Value="newPlan.Name" placeholder="e.g. Premium VIP" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label font-monospace small text-muted">Price ($)</label>
                                    <InputNumber class="form-control" @bind-Value="newPlan.Price" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label font-monospace small text-muted">Billing Cycle</label>
                                    <InputSelect class="form-select" @bind-Value="newPlan.BillingCycle">
                                        @foreach (var cycle in Enum.GetValues<BillingCycle>())
                                        {
                                            <option value="@cycle">@cycle</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label font-monospace small text-muted">Duration (Days)</label>
                                    <InputNumber class="form-control" @bind-Value="newPlan.DurationDays" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label font-monospace small text-muted">Description</label>
                                    <InputTextArea class="form-control" @bind-Value="newPlan.Description" rows="2" />
                                </div>
                                <button type="submit" class="btn btn-primary w-100 fw-bold py-2">Create Plan</button>
                            </EditForm>
                        </div>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="row g-3">
                        @foreach (var plan in plans)
                        {
                            <div class="col-md-6">
                                <div class="card h-100 border-0 shadow-sm rounded-3">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h4 class="fw-bold mb-0 text-primary">@plan.Name</h4>
                                            <span class="badge bg-success fs-6">$@plan.Price</span>
                                        </div>
                                        <p class="text-muted small mb-2">@plan.Description</p>
                                        <div class="d-flex justify-content-between small text-secondary border-top pt-2 mt-3">
                                            <span><i class="bi bi-clock me-1"></i>@plan.BillingCycle (@plan.DurationDays Days)</span>
                                            <span class="badge @(plan.IsActive ? "bg-info text-dark" : "bg-secondary")">@(plan.IsActive ? "Active" : "Inactive")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (activeTab == "subscriptions")
        {
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light py-3">
                    <h5 class="mb-0 fw-semibold">Member Subscriptions</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Member</th>
                                    <th>Plan</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Status</th>
                                    <th>Auto Renew</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!subscriptions.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">No subscriptions registered yet.</td>
                                    </tr>
                                }
                                @foreach (var sub in subscriptions)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@sub.UserName</div>
                                            <div class="small text-muted">@sub.UserEmail</div>
                                        </td>
                                        <td><span class="badge bg-primary">@sub.PlanName ($@sub.Price)</span></td>
                                        <td>@sub.StartDate.ToString("MMM dd, yyyy")</td>
                                        <td>@sub.EndDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <span class="badge @(sub.Status == SubscriptionStatus.Active ? "bg-success" : "bg-warning text-dark")">
                                                @sub.Status
                                            </span>
                                        </td>
                                        <td>@(sub.AutoRenew ? "Yes" : "No")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (activeTab == "payments")
        {
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light py-3">
                    <h5 class="mb-0 fw-semibold">Payment History</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>User</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                    <th>Method</th>
                                    <th>Ref</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!payments.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">No payment transactions recorded yet.</td>
                                    </tr>
                                }
                                @foreach (var p in payments)
                                {
                                    <tr>
                                        <td class="fw-bold">@p.UserName</td>
                                        <td class="fw-bold text-success">$@p.Amount</td>
                                        <td>@p.PaymentDate.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>@p.PaymentMethod</td>
                                        <td><code>@(p.TransactionReference ?? "N/A")</code></td>
                                        <td><span class="badge bg-success">@p.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private string activeTab = "plans";
    private bool isLoading = true;

    private List<SubscriptionPlanDto> plans = new();
    private List<SubscriptionDto> subscriptions = new();
    private List<PaymentDto> payments = new();

    private PlanFormModel newPlan = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var pList = await SubscriptionService.GetAllPlansAsync(activeOnly: false);
            plans = pList.ToList();

            var sList = await SubscriptionService.GetAllSubscriptionsAsync();
            subscriptions = sList.ToList();

            var payList = await PaymentService.GetAllPaymentsAsync();
            payments = payList.ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleCreatePlan()
    {
        var request = new CreateSubscriptionPlanRequest(
            newPlan.Name,
            newPlan.Description,
            newPlan.Price,
            newPlan.BillingCycle,
            newPlan.DurationDays,
            newPlan.Features
        );

        await SubscriptionService.CreatePlanAsync(request);
        newPlan = new PlanFormModel();
        await LoadDataAsync();
    }

    public class PlanFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public decimal Price { get; set; } = 49.99m;
        public BillingCycle BillingCycle { get; set; } = BillingCycle.Monthly;
        public int DurationDays { get; set; } = 30;
        public string? Features { get; set; }
    }
}
