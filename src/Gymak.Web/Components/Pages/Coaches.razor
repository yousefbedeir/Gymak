@page "/coaches"
@using Gymak.Application.DTOs
@using Gymak.Application.Services
@using Gymak.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@inject IUserService UserService
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Coaches & Private Training - GYMAK</PageTitle>

<div class="py-2 anim-fade">
    <!-- ─── Header ─── -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4 anim-fade-up">
        <div>
            <h3 class="fw-bold text-white mb-1" style="font-family: 'Bebas Neue', sans-serif; font-size: 2.2rem; letter-spacing: 1.5px;">
                COACHES & PRIVATE TRAINING
            </h3>
            <p style="color: #6b7280; font-size: 0.85rem; margin: 0;">
                فريق مدربي Gymak OS المحترفين — اشتراك المتابعة الخاصة والتصميم الفردي للأنظمة
            </p>
        </div>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <button class="btn fw-bold rounded px-4 py-2 d-flex align-items-center gap-2"
                        style="background: #f5c518; color: #000; border: none; font-size: 0.85rem; letter-spacing: 0.5px; text-transform: uppercase;"
                        @onclick="OpenAddCoachModal">
                    <i class="bi bi-person-plus-fill"></i> إضافة كوتش جديد للسيستم
                </button>
            </Authorized>
        </AuthorizeView>
    </div>

    <!-- ─── Status Notification Banner ─── -->
    @if (subscriptionSuccessMessage != null)
    {
        <div class="d-flex align-items-center gap-2 p-3 rounded mb-4 anim-fade-up"
             style="background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3); color: #22c55e; font-size: 0.9rem;">
            <i class="bi bi-check-circle-fill flex-shrink-0 fs-5"></i>
            <span>@subscriptionSuccessMessage</span>
        </div>
    }

    <!-- ─── Coaches Directory Grid ─── -->
    @if (isLoading)
    {
        <div class="text-center py-5" style="color: #6b7280;">
            <div class="spinner-border spinner-border-sm me-2" style="color: #f5c518;"></div>
            جاري تحميل قائمة الكوتشز...
        </div>
    }
    else if (!coaches.Any())
    {
        <div class="text-center py-5" style="color: #6b7280;">
            <i class="bi bi-person-badge d-block mb-2" style="font-size: 2.5rem; color: #1f2937;"></i>
            لا يوجد مدربين مسجلين في السيستم حالياً.
        </div>
    }
    else
    {
        <div class="row g-4 anim-fade-up-d1 mb-5">
            @foreach (var coach in coaches)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="p-4 rounded h-100 d-flex flex-column hover-lift"
                         style="background: #111111; border: 1px solid rgba(245,197,24,0.25); box-shadow: 0 8px 30px rgba(0,0,0,0.4); transition: all 0.25s;">
                        
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="d-flex align-items-center justify-content-center fw-bold text-black rounded-circle flex-shrink-0"
                                 style="width: 54px; height: 54px; background: #f5c518; font-size: 1.2rem; box-shadow: 0 4px 15px rgba(245,197,24,0.3);">
                                @GetInitials(coach.FullName)
                            </div>
                            <div>
                                <h5 class="fw-bold text-white mb-0" style="font-size: 1.1rem;">@coach.FullName</h5>
                                <span class="badge-gold px-2 py-0.5 text-uppercase" style="font-size: 0.68rem;">Head Trainer</span>
                            </div>
                        </div>

                        <div class="mb-3 p-2.5 rounded" style="background: #181818; border: 1px solid rgba(255,255,255,0.05);">
                            <div style="color: #6b7280; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px;" class="mb-1">التخصص الأساسي:</div>
                            <div class="fw-semibold text-white small">
                                <i class="bi bi-lightning-charge-fill me-1" style="color: #f5c518;"></i>تضخيم، تنشيف، وتصميم البرامج الخاصة
                            </div>
                        </div>

                        <p class="small flex-grow-1 mb-4" style="color: #9ca3af; font-size: 0.85rem; line-height: 1.5;">
                            خبرة تزيد عن 8 سنوات في التدريب الرياضي والمتابعة الفردية، متابعة يومية للوجبات والتمارين وتقييم الأوزان.
                        </p>

                        <div class="pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div>
                                    <div style="color: #6b7280; font-size: 0.7rem; text-transform: uppercase;">اشتراك المتابعة الخاصة</div>
                                    <span class="fw-bold text-white font-monospace" style="font-size: 1.2rem; color: #f5c518 !important;">$120 / شهر</span>
                                </div>
                                <span class="px-2 py-1 rounded" style="background: rgba(34,197,94,0.15); color: #22c55e; font-size: 0.75rem; font-weight: 600;">
                                    <i class="bi bi-circle-fill me-1" style="font-size: 0.4rem;"></i>متاح للمتابعة
                                </span>
                            </div>

                            <button class="w-100 btn fw-bold rounded py-2 d-flex align-items-center justify-content-center gap-2"
                                    style="background: #f5c518; color: #000; border: none; font-size: 0.85rem; letter-spacing: 0.5px;"
                                    @onclick="() => RequestPrivateCoaching(coach)">
                                <i class="bi bi-star-fill"></i> اشترك مع الكوتش الآن
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ─── Modal: Add New Coach (Admin Only) ─── -->
@if (showAddCoachModal)
{
    <div class="modal fade show d-block anim-fade" tabindex="-1" style="background: rgba(0,0,0,0.8);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded text-white" style="background: #111111; border: 1px solid rgba(245,197,24,0.3) !important;">
                <div class="modal-header p-4" style="border-bottom: 1px solid rgba(255,255,255,0.07);">
                    <h5 class="modal-title fw-bold" style="font-size: 1.1rem; font-family: 'Bebas Neue', sans-serif; letter-spacing: 1px;">
                        <i class="bi bi-person-plus-fill me-2" style="color: #f5c518;"></i>إضافة كوتش جديد للسيستم
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAddCoachModal"></button>
                </div>
                <div class="modal-body p-4">
                    @if (createErrorMessage != null)
                    {
                        <div class="p-3 rounded mb-3" style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #ef4444; font-size: 0.85rem;">
                            @createErrorMessage
                        </div>
                    }

                    <div class="mb-3">
                        <label class="d-block mb-1" style="color: #9ca3af; font-size: 0.8rem; text-transform: uppercase;">اسم الكوتش بالكامل</label>
                        <input type="text" class="w-100 rounded py-2 px-3 text-white border-0"
                               style="background: #181818; border: 1px solid rgba(255,255,255,0.1) !important; font-size: 0.88rem; outline: none;"
                               @bind="newCoachModel.FullName" placeholder="مثال: كابتن أحمد حسن" />
                    </div>

                    <div class="mb-3">
                        <label class="d-block mb-1" style="color: #9ca3af; font-size: 0.8rem; text-transform: uppercase;">البريد الإلكتروني</label>
                        <input type="email" class="w-100 rounded py-2 px-3 text-white border-0"
                               style="background: #181818; border: 1px solid rgba(255,255,255,0.1) !important; font-size: 0.88rem; outline: none;"
                               @bind="newCoachModel.Email" placeholder="coach@gymak.com" />
                    </div>

                    <div class="mb-3">
                        <label class="d-block mb-1" style="color: #9ca3af; font-size: 0.8rem; text-transform: uppercase;">رقم الهاتف</label>
                        <input type="tel" class="w-100 rounded py-2 px-3 text-white border-0"
                               style="background: #181818; border: 1px solid rgba(255,255,255,0.1) !important; font-size: 0.88rem; outline: none;"
                               @bind="newCoachModel.PhoneNumber" placeholder="+2010..." />
                    </div>

                    <div class="mb-0">
                        <label class="d-block mb-1" style="color: #9ca3af; font-size: 0.8rem; text-transform: uppercase;">كلمة السر الابتدائية</label>
                        <input type="password" class="w-100 rounded py-2 px-3 text-white border-0"
                               style="background: #181818; border: 1px solid rgba(255,255,255,0.1) !important; font-size: 0.88rem; outline: none;"
                               @bind="newCoachModel.Password" placeholder="••••••••" />
                    </div>
                </div>
                <div class="modal-footer p-3" style="border-top: 1px solid rgba(255,255,255,0.07);">
                    <button type="button" class="btn btn-sm rounded px-4"
                            style="background: transparent; border: 1px solid rgba(255,255,255,0.12); color: #9ca3af;"
                            @onclick="CloseAddCoachModal">إلغاء</button>
                    <button type="button" class="btn btn-sm fw-bold rounded px-4"
                            style="background: #f5c518; color: #000; border: none;"
                            @onclick="HandleAddCoach" disabled="@isCreatingCoach">
                        @if (isCreatingCoach)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>جاري الإضافة...</span>
                        }
                        else
                        {
                            <span>إضافة الكوتش</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto> coaches = new();
    private bool isLoading = true;

    private bool showAddCoachModal;
    private bool isCreatingCoach;
    private string? createErrorMessage;
    private string? subscriptionSuccessMessage;

    private CoachFormModel newCoachModel = new();

    private class CoachFormModel
    {
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string? PhoneNumber { get; set; }
    }

    protected override async Task OnInitializedAsync() => await LoadCoaches();

    private async Task LoadCoaches()
    {
        isLoading = true;
        try
        {
            coaches = (await UserService.GetUsersByRoleAsync(UserRole.Trainer)).ToList();
        }
        finally { isLoading = false; }
    }

    private void OpenAddCoachModal() { newCoachModel = new(); createErrorMessage = null; showAddCoachModal = true; }
    private void CloseAddCoachModal() => showAddCoachModal = false;

    private async Task HandleAddCoach()
    {
        if (string.IsNullOrWhiteSpace(newCoachModel.FullName) || string.IsNullOrWhiteSpace(newCoachModel.Email) || string.IsNullOrWhiteSpace(newCoachModel.Password))
        { createErrorMessage = "يرجى ملء جميع الحقول المطلوبة."; return; }

        isCreatingCoach = true; createErrorMessage = null;
        try
        {
            await UserService.CreateUserAsync(new CreateUserRequest(newCoachModel.FullName, newCoachModel.Email, newCoachModel.Password, newCoachModel.PhoneNumber, UserRole.Trainer));
            showAddCoachModal = false;
            await LoadCoaches();
        }
        catch (Exception ex) { createErrorMessage = ex.Message; }
        finally { isCreatingCoach = false; }
    }

    private void RequestPrivateCoaching(UserDto coach)
    {
        subscriptionSuccessMessage = $"تم تسجيل طلبك للاشتراك مع {coach.FullName} بنجاح! سيتواصل معك الكوتش لإعداد برنامجك التغذوي والتدريبي الخاص.";
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "C";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return (parts[0][..1] + parts[^1][..1]).ToUpper();
    }
}
