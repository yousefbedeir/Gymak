@page "/reset-password"
@using Gymak.Application.DTOs
@using Gymak.Application.Services
@using Gymak.Web.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Reset Password - Gymak Fitness OS</PageTitle>

<div class="reset-wrapper d-flex align-items-center justify-content-center min-vh-100 py-5" style="background: radial-gradient(circle at top right, #1e293b, #0f172a);">
    <div class="card border-0 shadow-lg p-4 p-md-5 rounded-4 text-white" style="max-width: 440px; width: 100%; background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.1);">
        
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="brand-icon mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-info bg-gradient text-dark" style="width: 60px; height: 60px; box-shadow: 0 0 20px rgba(6, 182, 212, 0.4);">
                <i class="bi bi-shield-lock-fill fs-2"></i>
            </div>
            <h3 class="fw-bold tracking-tight mb-1">Reset Password</h3>
            <p class="text-muted small">Enter your reset code and set a new secure password</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 rounded-3 small mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>@errorMessage</div>
            </div>
        }

        @if (isSuccess)
        {
            <div class="alert alert-success border-0 bg-success bg-opacity-20 text-success p-3 rounded-3 mb-4 text-center">
                <i class="bi bi-check-circle-fill fs-1 d-block mb-2"></i>
                <h5 class="fw-bold text-white mb-1">Password Reset Successfully!</h5>
                <p class="small text-white-50 mb-3">You can now sign in using your new password.</p>
                <a href="login" class="btn btn-primary w-100 fw-semibold">Go to Login</a>
            </div>
        }
        else
        {
            <EditForm Model="resetModel" OnValidSubmit="HandleResetPassword" FormName="ResetPasswordForm">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="email" class="form-label text-white-50 small fw-medium">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text border-0 bg-dark text-muted"><i class="bi bi-envelope"></i></span>
                        <input id="email" type="email" class="form-control bg-dark border-0 text-white shadow-none" placeholder="name@gymak.com" @bind="resetModel.Email" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="token" class="form-label text-white-50 small fw-medium">Reset Code / Token</label>
                    <div class="input-group">
                        <span class="input-group-text border-0 bg-dark text-muted"><i class="bi bi-key"></i></span>
                        <input id="token" type="text" class="form-control bg-dark border-0 text-white font-monospace shadow-none" placeholder="123456" @bind="resetModel.Token" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="newPassword" class="form-label text-white-50 small fw-medium">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text border-0 bg-dark text-muted"><i class="bi bi-lock"></i></span>
                        <input id="newPassword" type="password" class="form-control bg-dark border-0 text-white shadow-none" placeholder="••••••••" @bind="resetModel.NewPassword" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="confirmNewPassword" class="form-label text-white-50 small fw-medium">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text border-0 bg-dark text-muted"><i class="bi bi-shield-check"></i></span>
                        <input id="confirmNewPassword" type="password" class="form-control bg-dark border-0 text-white shadow-none" placeholder="••••••••" @bind="resetModel.ConfirmNewPassword" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-info w-100 py-2.5 fw-semibold rounded-3 mt-3 d-flex align-items-center justify-content-center gap-2" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Resetting Password...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle"></i>
                        <span>Reset Password</span>
                    }
                </button>
            </EditForm>
        }

        <div class="text-center mt-4">
            <a href="login" class="text-muted text-decoration-none small"><i class="bi bi-arrow-left me-1"></i> Back to Login</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private ResetModelInput resetModel = new();
    private string? errorMessage;
    private bool isSuccess;
    private bool isLoading;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Email))
        {
            resetModel.Email = Email;
        }
        if (!string.IsNullOrEmpty(Token))
        {
            resetModel.Token = Token;
        }
    }

    private class ResetModelInput
    {
        public string Email { get; set; } = string.Empty;
        public string Token { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }

    private async Task HandleResetPassword()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var req = new ResetPasswordRequest(
                resetModel.Email,
                resetModel.Token,
                resetModel.NewPassword,
                resetModel.ConfirmNewPassword
            );

            var result = await AuthService.ResetPasswordAsync(req);

            if (result.Succeeded)
            {
                isSuccess = true;
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Failed to reset password. Please check your reset code.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
