@page "/"
@layout Layout.AuthLayout

<PageTitle>GYMAK</PageTitle>

<section class="auth-home-shell">
    <div class="auth-home-bg" aria-hidden="true">
        <img src="/images/gym_cardio_treadmill.jpg" alt="" />
    </div>

    <nav class="auth-home-nav anim-fade">
        <a class="auth-brand" href="">
            <span class="auth-brand-mark">
                <i class="bi bi-lightning-charge-fill"></i>
            </span>
            <span>
                <strong>GYMAK</strong>
                <small>TRAINING & NUTRITION</small>
            </span>
        </a>

        <div class="auth-nav-actions">
            <AuthorizeView>
                <Authorized>
                    <a class="auth-nav-link" href="profile">Profile</a>
                    <a class="auth-nav-button" href="subscriptions">
                        <i class="bi bi-speedometer2"></i>
                        <span>Open App</span>
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a class="auth-nav-link" href="login">Sign In</a>
                    <a class="auth-nav-button" href="register">
                        <i class="bi bi-person-plus-fill"></i>
                        <span>Register</span>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>

    <div class="auth-home-content">
        <div class="auth-copy">
            <div class="auth-eyebrow anim-fade-up">
                <i class="bi bi-shield-check"></i>
                Training and nutrition guide
            </div>

            <div class="auth-title anim-fade-up-d1" role="heading" aria-level="1">GYMAK</div>

            <p class="auth-lede anim-fade-up-d2">
                Discover the right exercises for every muscle group and learn how smart nutrition supports your goals.
                Build better routines, make stronger food choices, and keep every step of your fitness journey clear and organized.
            </p>

            <AuthorizeView>
                <Authorized>
                    <div class="auth-cta-row anim-fade-up-d3">
                        <a class="auth-primary-btn" href="profile">
                            <i class="bi bi-person-circle"></i>
                            <span>My Profile</span>
                        </a>
                        <a class="auth-secondary-btn" href="subscriptions">
                            <i class="bi bi-credit-card-fill"></i>
                            <span>Subscriptions</span>
                        </a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="auth-cta-row anim-fade-up-d3">
                        <a class="auth-primary-btn" href="login">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Sign In</span>
                        </a>
                        <a class="auth-secondary-btn" href="register">
                            <i class="bi bi-person-plus-fill"></i>
                            <span>Create Account</span>
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <div class="auth-visual-stage" aria-label="Gymak access preview">
            <div class="auth-photo auth-photo-main anim-fade-up-d2">
                <img src="/images/gym_cardio_group.jpg" alt="Young man and woman running on treadmills" />
                <span>CARDIO ZONE</span>
            </div>

            <div class="auth-photo auth-photo-side anim-fade-up-d4">
                <img src="/images/gym_cardio_treadmill.jpg" alt="Modern cardio gym with treadmill runners" />
                <span>GROUP CARDIO</span>
            </div>

            <div class="auth-status-panel anim-fade-up-d5">
                <div>
                    <small>AUTH STATUS</small>
                    <strong>READY</strong>
                </div>
                <i class="bi bi-lock-fill"></i>
            </div>
        </div>
    </div>

    <div class="auth-feature-strip anim-fade-up-d5">
        <a href="login">
            <i class="bi bi-box-arrow-in-right"></i>
            <span>Sign In</span>
        </a>
        <a href="register">
            <i class="bi bi-person-plus-fill"></i>
            <span>Create Account</span>
        </a>
    </div>
</section>
