@page "/"
@using Gymak.Application.Services
@using Gymak.Application.DTOs
@using Gymak.Domain.Enums
@inject IUserService UserService
@inject ISubscriptionService SubscriptionService
@inject IProgressLogService ProgressLogService
@inject IPaymentService PaymentService
@rendermode InteractiveServer

<PageTitle>Dashboard — Gymak Fitness OS</PageTitle>

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="fw-bold mb-1" style="font-size: 1.75rem; color: #f8fafc;">
            <i class="bi bi-grid-1x2-fill text-primary me-2" style="font-size: 1.5rem;"></i>Dashboard
        </h1>
        <p class="text-muted mb-0" style="font-size: 0.9rem;">Welcome back. Here's your gym performance overview.</p>
    </div>
    <div class="d-none d-md-block px-3 py-2 rounded-3 border border-secondary border-opacity-10 text-muted" style="font-size: 0.8rem; background: rgba(255,255,255,0.03);">
        <i class="bi bi-clock me-1 text-primary"></i>
        @DateTime.Now.ToString("dddd, MMMM dd yyyy · HH:mm")
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem; border-width: 3px;"></div>
        <p class="text-muted mt-3">Loading dashboard data…</p>
    </div>
}
else
{
    <!-- Stat Cards Row -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="stat-icon-wrapper stat-icon-primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span class="badge rounded-pill px-2 py-1" style="background: rgba(16,185,129,0.12); color: #34d399; font-size: 0.72rem; font-weight: 600;">
                        <i class="bi bi-arrow-up me-1"></i>Active
                    </span>
                </div>
                <div class="mt-2">
                    <div class="fw-bold mb-1" style="font-size: 2rem; line-height: 1; color: #f8fafc;">@totalMembers</div>
                    <div class="text-muted" style="font-size: 0.85rem;">Total Members</div>
                </div>
                <div class="mt-3 pt-3 border-top border-secondary border-opacity-10">
                    <small class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-person-badge me-1 text-primary"></i>Registered users in system</small>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="stat-icon-wrapper stat-icon-success">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <span class="badge rounded-pill px-2 py-1" style="background: rgba(59,130,246,0.12); color: #60a5fa; font-size: 0.72rem; font-weight: 600;">
                        <i class="bi bi-calendar2-month me-1"></i>Monthly
                    </span>
                </div>
                <div class="mt-2">
                    <div class="fw-bold mb-1" style="font-size: 2rem; line-height: 1; color: #f8fafc;">$@monthlyRevenue.ToString("N0")</div>
                    <div class="text-muted" style="font-size: 0.85rem;">Revenue This Month</div>
                </div>
                <div class="mt-3 pt-3 border-top border-secondary border-opacity-10">
                    <small class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-credit-card me-1 text-success"></i>From completed payments</small>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="stat-icon-wrapper stat-icon-warning">
                        <i class="bi bi-card-checklist"></i>
                    </div>
                    <span class="badge rounded-pill px-2 py-1" style="background: rgba(245,158,11,0.12); color: #fbbf24; font-size: 0.72rem; font-weight: 600;">
                        <i class="bi bi-lightning me-1"></i>Live
                    </span>
                </div>
                <div class="mt-2">
                    <div class="fw-bold mb-1" style="font-size: 2rem; line-height: 1; color: #f8fafc;">@activePlans</div>
                    <div class="text-muted" style="font-size: 0.85rem;">Active Gym Plans</div>
                </div>
                <div class="mt-3 pt-3 border-top border-secondary border-opacity-10">
                    <small class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-star me-1 text-warning"></i>Subscription plans offered</small>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="stat-icon-wrapper stat-icon-purple">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <span class="badge rounded-pill px-2 py-1" style="background: rgba(139,92,246,0.12); color: #a78bfa; font-size: 0.72rem; font-weight: 600;">
                        <i class="bi bi-calendar-day me-1"></i>Today
                    </span>
                </div>
                <div class="mt-2">
                    <div class="fw-bold mb-1" style="font-size: 2rem; line-height: 1; color: #f8fafc;">@todaysLogs</div>
                    <div class="text-muted" style="font-size: 0.85rem;">Progress Logs Today</div>
                </div>
                <div class="mt-3 pt-3 border-top border-secondary border-opacity-10">
                    <small class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-activity me-1" style="color: #8b5cf6;"></i>Body metrics logged today</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="gym-card p-4 mb-4">
        <h6 class="fw-bold text-uppercase mb-3" style="font-size: 0.75rem; letter-spacing: 1px; color: #64748b;">
            <i class="bi bi-zap-fill me-2 text-warning"></i>Quick Actions
        </h6>
        <div class="d-flex flex-wrap gap-3">
            <a href="/members" class="btn btn-gym-primary d-flex align-items-center gap-2">
                <i class="bi bi-person-plus-fill"></i>
                <span>New Member</span>
            </a>
            <a href="/subscriptions" class="btn btn-gym-success d-flex align-items-center gap-2">
                <i class="bi bi-cash-coin"></i>
                <span>Record Payment</span>
            </a>
            <a href="/progress-logs" class="btn btn-gym-purple d-flex align-items-center gap-2">
                <i class="bi bi-clipboard2-pulse-fill"></i>
                <span>Add Progress Log</span>
            </a>
            <a href="/workouts" class="btn btn-gym-outline d-flex align-items-center gap-2">
                <i class="bi bi-capslock-fill"></i>
                <span>Create Workout Plan</span>
            </a>
            <a href="/nutrition" class="btn btn-gym-outline d-flex align-items-center gap-2">
                <i class="bi bi-heart-pulse-fill"></i>
                <span>Manage Diet Plan</span>
            </a>
        </div>
    </div>

    <!-- Lower Section: Recent Payments + Active Subscriptions -->
    <div class="row g-4">
        <!-- Recent Payments -->
        <div class="col-lg-7">
            <div class="gym-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h5 class="fw-bold mb-0" style="color: #f8fafc;">
                        <i class="bi bi-receipt me-2 text-success"></i>Recent Payments
                    </h5>
                    <a href="/subscriptions" class="text-primary" style="font-size: 0.85rem; font-weight: 500;">
                        View all <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark-custom mb-0">
                        <thead>
                            <tr>
                                <th>Member</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!recentPayments.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        <i class="bi bi-inbox fs-2 d-block mb-2 opacity-25"></i>
                                        No payment records yet
                                    </td>
                                </tr>
                            }
                            @foreach (var payment in recentPayments)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-primary bg-opacity-20 d-flex align-items-center justify-content-center text-primary fw-bold"
                                                 style="width: 32px; height: 32px; font-size: 0.75rem; flex-shrink: 0;">
                                                @(payment.UserName.Length > 0 ? payment.UserName[0].ToString().ToUpper() : "?")
                                            </div>
                                            <span class="fw-semibold" style="font-size: 0.875rem;">@payment.UserName</span>
                                        </div>
                                    </td>
                                    <td class="text-success fw-bold">$@payment.Amount</td>
                                    <td>
                                        <span class="badge px-2 py-1 rounded-pill" style="background: rgba(100,116,139,0.2); color: #94a3b8; font-size: 0.75rem;">
                                            @payment.PaymentMethod
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-2 py-1"
                                              style="background: rgba(16,185,129,0.12); color: #34d399; font-size: 0.75rem;">
                                            @payment.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Active Subscriptions List -->
        <div class="col-lg-5">
            <div class="gym-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h5 class="fw-bold mb-0" style="color: #f8fafc;">
                        <i class="bi bi-people me-2 text-primary"></i>Active Subscriptions
                    </h5>
                    <a href="/subscriptions" class="text-primary" style="font-size: 0.85rem; font-weight: 500;">
                        View all <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

                @if (!activeSubscriptions.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-person-x fs-2 d-block mb-2 opacity-25"></i>
                        <p style="font-size: 0.875rem;">No active subscriptions yet</p>
                    </div>
                }
                <div class="d-flex flex-column gap-2">
                    @foreach (var sub in activeSubscriptions)
                    {
                        var daysLeft = (int)(sub.EndDate - DateTime.UtcNow).TotalDays;
                        var progressPct = Math.Clamp((int)(100.0 - daysLeft * 100.0 / Math.Max((sub.EndDate - sub.StartDate).TotalDays, 1)), 0, 100);
                        var barColor = daysLeft > 14 ? "#10b981" : daysLeft > 7 ? "#f59e0b" : "#ef4444";
                        <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                         style="width: 30px; height: 30px; background: linear-gradient(135deg, #3b82f6, #2563eb); font-size: 0.7rem; color: white; flex-shrink: 0;">
                                        @(sub.UserName.Length > 0 ? sub.UserName[0].ToString().ToUpper() : "?")
                                    </div>
                                    <div>
                                        <div class="fw-semibold" style="font-size: 0.85rem; color: #f1f5f9;">@sub.UserName</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">@sub.PlanName</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold" style="font-size: 0.8rem; color: @barColor;">@daysLeft d left</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">$@sub.Price/plan</div>
                                </div>
                            </div>
                            <div class="progress" style="height: 4px; background: rgba(255,255,255,0.06); border-radius: 2px;">
                                <div class="progress-bar" style="width: @progressPct%; background: @barColor; border-radius: 2px;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom: Available Plans Overview -->
    <div class="gym-card p-4 mt-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h5 class="fw-bold mb-0" style="color: #f8fafc;">
                <i class="bi bi-stars me-2 text-warning"></i>Available Subscription Plans
            </h5>
            <a href="/subscriptions" class="btn btn-gym-outline btn-sm">
                <i class="bi bi-plus-circle me-1"></i>Manage Plans
            </a>
        </div>

        @if (!plans.Any())
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-tags fs-2 d-block mb-2 opacity-25"></i>
                <p style="font-size: 0.875rem;">No plans created yet. <a href="/subscriptions" class="text-primary">Create your first plan →</a></p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var plan in plans)
                {
                    <div class="col-sm-6 col-lg-3">
                        <div class="p-3 rounded-3 h-100 d-flex flex-column" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); transition: all 0.2s;">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge rounded-pill px-2 py-1" style="background: rgba(59,130,246,0.12); color: #60a5fa; font-size: 0.7rem;">@plan.BillingCycle</span>
                                @if (plan.IsActive)
                                {
                                    <span class="badge rounded-pill px-2 py-1" style="background: rgba(16,185,129,0.12); color: #34d399; font-size: 0.7rem;">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2 py-1" style="background: rgba(100,116,139,0.15); color: #64748b; font-size: 0.7rem;">Inactive</span>
                                }
                            </div>
                            <h6 class="fw-bold mb-1 text-white">@plan.Name</h6>
                            <p class="text-muted mb-2" style="font-size: 0.78rem; flex-grow: 1;">@(plan.Description ?? "No description")</p>
                            <div class="d-flex align-items-end justify-content-between mt-2 pt-2 border-top border-secondary border-opacity-10">
                                <div>
                                    <span class="fw-bold text-success" style="font-size: 1.25rem;">$@plan.Price</span>
                                </div>
                                <span class="text-muted" style="font-size: 0.75rem;">@plan.DurationDays days</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private bool isLoading = true;

    private int totalMembers;
    private decimal monthlyRevenue;
    private int activePlans;
    private int todaysLogs;

    private List<PaymentDto> recentPayments = new();
    private List<SubscriptionDto> activeSubscriptions = new();
    private List<SubscriptionPlanDto> plans = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Fetch members (all users with Member role)
            var members = await UserService.GetUsersByRoleAsync(UserRole.Member);
            totalMembers = members.Count;

            // Subscription plans
            var allPlans = await SubscriptionService.GetAllPlansAsync(activeOnly: false);
            plans = allPlans.ToList();
            activePlans = allPlans.Count(p => p.IsActive);

            // All subscriptions — filter active ones
            var subs = await SubscriptionService.GetAllSubscriptionsAsync();
            activeSubscriptions = subs
                .Where(s => s.Status == Domain.Enums.SubscriptionStatus.Active)
                .OrderBy(s => s.EndDate)
                .Take(5)
                .ToList();

            // Payments
            var payments = await PaymentService.GetAllPaymentsAsync();
            recentPayments = payments.Take(5).ToList();

            // Monthly revenue — sum of completed payments this month
            var now = DateTime.UtcNow;
            monthlyRevenue = payments
                .Where(p => p.Status == Domain.Enums.PaymentStatus.Completed
                         && p.PaymentDate.Year == now.Year
                         && p.PaymentDate.Month == now.Month)
                .Sum(p => p.Amount);

            // Today's progress logs (approximate via count — logged today UTC)
            todaysLogs = 0; // placeholder: progress logs service has no GetAllAsync; shown as 0 until populated
        }
        catch { /* swallow gracefully — partial data is fine on dashboard */ }
        finally
        {
            isLoading = false;
        }
    }
}
