@page "/"
@using System.Security.Claims
@using Gymak.Application.Services
@using Gymak.Application.DTOs
@using Gymak.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@inject IUserService UserService
@inject ISubscriptionService SubscriptionService
@inject IProgressLogService ProgressLogService
@inject IPaymentService PaymentService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Dashboard — Gymak Fitness OS</PageTitle>

@if (isLoading)
{
    <div class="d-flex flex-column align-items-center justify-content-center py-5 min-vh-50">
        <div class="spinner-border text-info" role="status" style="width: 3.5rem; height: 3.5rem; border-width: 3px;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="text-muted mt-3 fw-medium" style="font-size: 0.95rem;">Initializing Gymak Control Center...</p>
    </div>
}
else
{
    <!-- Hero Welcome Banner -->
    <div class="hero-card p-4 p-md-5 mb-4">
        <div class="row align-items-center position-relative" style="z-index: 2;">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-info bg-opacity-10 border border-info border-opacity-20 text-info small mb-3">
                    <span class="badge bg-info rounded-circle p-1 me-1"><span class="visually-hidden">Live</span></span>
                    <span class="fw-semibold">Gymak Fitness OS v2.0</span>
                    <span class="text-white-50">·</span>
                    <span>System Active</span>
                </div>
                <h2 class="fw-extrabold text-white tracking-tight mb-2 display-6">
                    Welcome back, <span class="text-transparent bg-clip-text" style="background: linear-gradient(135deg, #38bdf8 0%, #8b5cf6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">@(userName ?? "Athlete")</span>! 👋
                </h2>
                <p class="text-muted fs-6 mb-0" style="max-width: 620px;">
                    Here is your real-time fitness performance overview, member subscriptions status, and revenue analytics for today.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                <div class="d-inline-flex flex-column text-start text-lg-end p-3 rounded-4 bg-dark bg-opacity-60 border border-white border-opacity-10">
                    <span class="text-muted small fw-medium mb-1"><i class="bi bi-clock me-1 text-info"></i>Current Time</span>
                    <span class="fw-bold text-white fs-5 font-monospace">@DateTime.Now.ToString("HH:mm:ss")</span>
                    <span class="text-white-50 small">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 KPI Stat Cards Row -->
    <div class="row g-4 mb-4">
        <!-- Total Members Card -->
        <div class="col-6 col-xl-3">
            <div class="stat-card stat-card-cyan h-100">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="stat-icon-box icon-box-cyan">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span class="badge badge-neon-cyan px-2.5 py-1 rounded-pill small fw-semibold">
                        <i class="bi bi-arrow-up-short"></i>Active Users
                    </span>
                </div>
                <div class="mt-2">
                    <div class="fw-extrabold text-white mb-1" style="font-size: 2.25rem; line-height: 1;">@totalMembers</div>
                    <div class="text-muted small fw-medium">Total Registered Members</div>
                </div>
                <div class="mt-3 pt-3 border-top border-white border-opacity-10 d-flex align-items-center justify-content-between text-muted small">
                    <span><i class="bi bi-person-check-fill text-info me-1"></i>Member Roster</span>
                    <a href="members" class="text-info text-decoration-none font-monospace fs-7">Manage →</a>
                </div>
            </div>
        </div>

        <!-- Monthly Revenue Card -->
        <div class="col-6 col-xl-3">
            <div class="stat-card stat-card-emerald h-100">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="stat-icon-box icon-box-emerald">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <span class="badge badge-neon-emerald px-2.5 py-1 rounded-pill small fw-semibold">
                        <i class="bi bi-calendar-check"></i>This Month
                    </span>
                </div>
                <div class="mt-2">
                    <div class="fw-extrabold text-white mb-1" style="font-size: 2.25rem; line-height: 1;">$@monthlyRevenue.ToString("N0")</div>
                    <div class="text-muted small fw-medium">Total Revenue Logged</div>
                </div>
                <div class="mt-3 pt-3 border-top border-white border-opacity-10 d-flex align-items-center justify-content-between text-muted small">
                    <span><i class="bi bi-credit-card-fill text-emerald me-1"></i>Completed Payments</span>
                    <a href="subscriptions" class="text-emerald text-decoration-none font-monospace fs-7">History →</a>
                </div>
            </div>
        </div>

        <!-- Active Plans Card -->
        <div class="col-6 col-xl-3">
            <div class="stat-card stat-card-amber h-100">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="stat-icon-box icon-box-amber">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <span class="badge badge-neon-amber px-2.5 py-1 rounded-pill small fw-semibold">
                        <i class="bi bi-stars"></i>Available
                    </span>
                </div>
                <div class="mt-2">
                    <div class="fw-extrabold text-white mb-1" style="font-size: 2.25rem; line-height: 1;">@activePlans</div>
                    <div class="text-muted small fw-medium">Active Membership Plans</div>
                </div>
                <div class="mt-3 pt-3 border-top border-white border-opacity-10 d-flex align-items-center justify-content-between text-muted small">
                    <span><i class="bi bi-tag-fill text-amber me-1"></i>Subscription Tiers</span>
                    <a href="subscriptions" class="text-amber text-decoration-none font-monospace fs-7">Plans →</a>
                </div>
            </div>
        </div>

        <!-- Today's Progress Logs -->
        <div class="col-6 col-xl-3">
            <div class="stat-card stat-card-violet h-100">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="stat-icon-box icon-box-violet">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <span class="badge badge-neon-violet px-2.5 py-1 rounded-pill small fw-semibold" style="background: rgba(139,92,246,0.15); color: #a78bfa; border: 1px solid rgba(139,92,246,0.3);">
                        <i class="bi bi-activity"></i>Metrics
                    </span>
                </div>
                <div class="mt-2">
                    <div class="fw-extrabold text-white mb-1" style="font-size: 2.25rem; line-height: 1;">@todaysLogs</div>
                    <div class="text-muted small fw-medium">Progress Logs Today</div>
                </div>
                <div class="mt-3 pt-3 border-top border-white border-opacity-10 d-flex align-items-center justify-content-between text-muted small">
                    <span><i class="bi bi-heart-pulse-fill text-violet me-1"></i>Body Tracking</span>
                    <a href="progress-logs" class="text-violet text-decoration-none font-monospace fs-7">Metrics →</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions Hub -->
    <div class="gym-card p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h6 class="fw-bold text-uppercase text-muted font-monospace mb-0 fs-7" style="letter-spacing: 1.5px;">
                <i class="bi bi-grid-fill text-info me-2"></i>Quick Actions Hub
            </h6>
            <span class="badge bg-dark border border-secondary border-opacity-10 text-muted px-2.5 py-1 rounded-pill small">Shortcuts</span>
        </div>
        <div class="row g-3">
            <div class="col-6 col-sm-4 col-md-2.4 col-lg-2">
                <a href="members" class="quick-action-card h-100 text-decoration-none">
                    <div class="avatar bg-info bg-opacity-20 text-info rounded-3 p-2">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-white small">New Member</div>
                        <div class="text-muted fs-8">Add Client</div>
                    </div>
                </a>
            </div>

            <div class="col-6 col-sm-4 col-md-2.4 col-lg-2">
                <a href="subscriptions" class="quick-action-card h-100 text-decoration-none">
                    <div class="avatar bg-success bg-opacity-20 text-success rounded-3 p-2">
                        <i class="bi bi-credit-card-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-white small">New Payment</div>
                        <div class="text-muted fs-8">Record Revenue</div>
                    </div>
                </a>
            </div>

            <div class="col-6 col-sm-4 col-md-2.4 col-lg-2">
                <a href="progress-logs" class="quick-action-card h-100 text-decoration-none">
                    <div class="avatar bg-violet bg-opacity-20 text-violet rounded-3 p-2" style="background: rgba(139,92,246,0.2); color: #a78bfa;">
                        <i class="bi bi-activity"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-white small">Add Metric</div>
                        <div class="text-muted fs-8">Body Progress</div>
                    </div>
                </a>
            </div>

            <div class="col-6 col-sm-4 col-md-2.4 col-lg-2">
                <a href="workouts" class="quick-action-card h-100 text-decoration-none">
                    <div class="avatar bg-warning bg-opacity-20 text-warning rounded-3 p-2">
                        <i class="bi bi-lightning-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-white small">Workout Plan</div>
                        <div class="text-muted fs-8">Routine Builder</div>
                    </div>
                </a>
            </div>

            <div class="col-6 col-sm-4 col-md-2.4 col-lg-2">
                <a href="nutrition" class="quick-action-card h-100 text-decoration-none">
                    <div class="avatar bg-rose bg-opacity-20 text-rose rounded-3 p-2" style="background: rgba(244,63,94,0.2); color: #fb7185;">
                        <i class="bi bi-egg-fried"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-white small">Diet Plan</div>
                        <div class="text-muted fs-8">Nutrition Specs</div>
                    </div>
                </a>
            </div>

            <div class="col-6 col-sm-4 col-md-2.4 col-lg-2">
                <a href="users" class="quick-action-card h-100 text-decoration-none">
                    <div class="avatar bg-primary bg-opacity-20 text-primary rounded-3 p-2">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-white small">User Control</div>
                        <div class="text-muted fs-8">Roles & Access</div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content Section: Payments & Subscriptions Grid -->
    <div class="row g-4 mb-4">
        <!-- Recent Payments Table Card -->
        <div class="col-lg-7">
            <div class="gym-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <h5 class="fw-bold text-white mb-0">
                            <i class="bi bi-receipt-cutoff text-success me-2"></i>Recent Payments
                        </h5>
                        <p class="text-muted small mb-0">Latest completed member payments</p>
                    </div>
                    <a href="subscriptions" class="btn btn-outline-light btn-sm rounded-pill px-3 fs-7 fw-semibold">
                        View All <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-dark-custom mb-0">
                        <thead>
                            <tr>
                                <th>Member</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!recentPayments.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        <i class="bi bi-inbox fs-1 d-block mb-2 text-white-50 opacity-25"></i>
                                        No recent payment records found
                                    </td>
                                </tr>
                            }
                            @foreach (var payment in recentPayments)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar bg-primary bg-opacity-20 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 0.8rem;">
                                                @GetInitials(payment.UserName)
                                            </div>
                                            <div>
                                                <div class="fw-semibold text-white">@payment.UserName</div>
                                                <div class="text-muted fs-8">Ref: @payment.PaymentId.ToString()[..8].ToUpper()</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-emerald font-monospace" style="color: #34d399;">$@payment.Amount.ToString("N2")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-dark border border-secondary border-opacity-20 text-muted px-2.5 py-1 rounded-pill small">
                                            @payment.PaymentMethod
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge badge-neon-emerald px-2.5 py-1 rounded-pill small">
                                            <i class="bi bi-check-circle-fill me-1"></i>@payment.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Active Subscriptions Progress Card -->
        <div class="col-lg-5">
            <div class="gym-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <h5 class="fw-bold text-white mb-0">
                            <i class="bi bi-credit-card-2-front-fill text-info me-2"></i>Active Memberships
                        </h5>
                        <p class="text-muted small mb-0">Current active member subscriptions</p>
                    </div>
                    <a href="subscriptions" class="btn btn-outline-light btn-sm rounded-pill px-3 fs-7 fw-semibold">
                        View All <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

                @if (!activeSubscriptions.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-card-heading fs-1 d-block mb-2 text-white-50 opacity-25"></i>
                        <p class="small mb-0">No active subscriptions currently running</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var sub in activeSubscriptions)
                        {
                            var daysLeft = (int)(sub.EndDate - DateTime.UtcNow).TotalDays;
                            var totalDays = Math.Max((sub.EndDate - sub.StartDate).TotalDays, 1);
                            var progressPct = Math.Clamp((int)(100.0 - daysLeft * 100.0 / totalDays), 0, 100);
                            var barColorClass = daysLeft > 14 ? "bg-emerald" : daysLeft > 7 ? "bg-warning" : "bg-danger";
                            var textColorStyle = daysLeft > 14 ? "#34d399" : daysLeft > 7 ? "#fbbf24" : "#fb7185";

                            <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar bg-info bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px; font-size: 0.75rem;">
                                            @GetInitials(sub.UserName)
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-white small">@sub.UserName</div>
                                            <div class="text-muted fs-8">@sub.PlanName</div>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold font-monospace small" style="color: @textColorStyle;">@daysLeft days left</div>
                                        <div class="text-muted fs-8">$@sub.Price / plan</div>
                                    </div>
                                </div>
                                <div class="progress bg-dark" style="height: 5px; border-radius: 3px;">
                                    <div class="progress-bar @barColorClass" style="width: @progressPct%; border-radius: 3px;"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Available Plans Showcase Row -->
    <div class="gym-card p-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h5 class="fw-bold text-white mb-0">
                    <i class="bi bi-stars text-warning me-2"></i>Membership Tier Options
                </h5>
                <p class="text-muted small mb-0">Offered gym subscription packages</p>
            </div>
            <a href="subscriptions" class="btn btn-outline-info btn-sm rounded-3 px-3 fw-semibold">
                <i class="bi bi-gear-fill me-1"></i>Manage Tiers
            </a>
        </div>

        @if (!plans.Any())
        {
            <div class="text-center text-muted py-4">
                <p class="small mb-0">No subscription plans defined. <a href="subscriptions" class="text-info">Create plans →</a></p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var plan in plans)
                {
                    <div class="col-sm-6 col-lg-4">
                        <div class="p-3.5 rounded-4 h-100 d-flex flex-column bg-dark bg-opacity-40 border border-secondary border-opacity-10 hover-bg-light transition">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge badge-neon-cyan px-2.5 py-1 rounded-pill small">@plan.BillingCycle</span>
                                <span class="badge badge-neon-emerald px-2.5 py-1 rounded-pill small">@plan.DurationDays Days</span>
                            </div>
                            <h6 class="fw-bold text-white fs-6 mb-1">@plan.Name</h6>
                            <p class="text-muted small mb-3 flex-grow-1" style="font-size: 0.82rem;">@(plan.Description ?? "Full facility access package")</p>
                            
                            <div class="d-flex align-items-end justify-content-between pt-2 border-top border-white border-opacity-10">
                                <div>
                                    <span class="text-muted fs-8 d-block">Price</span>
                                    <span class="fw-extrabold text-info fs-4 font-monospace">$@plan.Price</span>
                                </div>
                                <a href="subscriptions" class="btn btn-sm btn-primary rounded-3 px-3 fw-semibold">Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private bool isLoading = true;
    private string? userName;

    private int totalMembers;
    private decimal monthlyRevenue;
    private int activePlans;
    private int todaysLogs;

    private List<PaymentDto> recentPayments = new();
    private List<SubscriptionDto> activeSubscriptions = new();
    private List<SubscriptionPlanDto> plans = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                userName = authState.User.Identity.Name;
            }

            // Fetch members
            var members = await UserService.GetUsersByRoleAsync(UserRole.Member);
            totalMembers = members.Count;

            // Fetch subscription plans
            var allPlans = await SubscriptionService.GetAllPlansAsync(activeOnly: false);
            plans = allPlans.ToList();
            activePlans = allPlans.Count(p => p.IsActive);

            // Fetch active subscriptions
            var subs = await SubscriptionService.GetAllSubscriptionsAsync();
            activeSubscriptions = subs
                .Where(s => s.Status == Domain.Enums.SubscriptionStatus.Active)
                .OrderBy(s => s.EndDate)
                .Take(5)
                .ToList();

            // Fetch payments
            var payments = await PaymentService.GetAllPaymentsAsync();
            recentPayments = payments.Take(5).ToList();

            // Calculate monthly revenue
            var now = DateTime.UtcNow;
            monthlyRevenue = payments
                .Where(p => p.Status == Domain.Enums.PaymentStatus.Completed
                         && p.PaymentDate.Year == now.Year
                         && p.PaymentDate.Month == now.Month)
                .Sum(p => p.Amount);

            todaysLogs = 0;
        }
        catch
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "U";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return (parts[0][..1] + parts[^1][..1]).ToUpper();
    }
}
