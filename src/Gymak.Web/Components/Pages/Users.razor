@page "/users"
@using Gymak.Application.DTOs
@using Gymak.Application.Services
@using Gymak.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@inject IUserService UserService
@inject IAuthService AuthService
@rendermode InteractiveServer

<PageTitle>User Management - GYMAK</PageTitle>

<div class="py-2 anim-fade">
    <!-- ─── Header ─── -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4 anim-fade-up">
        <div>
            <h3 class="fw-bold text-white mb-1" style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 1px;">USER MANAGEMENT</h3>
            <p style="color: #6b7280; font-size: 0.85rem; margin: 0;">Manage system users, trainers, and member access privileges</p>
        </div>
        <button class="btn fw-bold rounded px-4 py-2 d-flex align-items-center gap-2"
                style="background: #f5c518; color: #000; border: none; font-size: 0.85rem; letter-spacing: 0.5px; text-transform: uppercase;"
                @onclick="OpenCreateUserModal">
            <i class="bi bi-person-plus-fill"></i> Add New User
        </button>
    </div>

    <!-- ─── Stats Row ─── -->
    <div class="row g-3 mb-4 anim-fade-up-d1">
        @foreach (var stat in new[] {
            ("All Users", usersList.Count.ToString(), "#f5c518", "bi-people-fill"),
            ("Admins", usersList.Count(u => u.Role == UserRole.Admin).ToString(), "#ef4444", "bi-shield-fill"),
            ("Trainers", usersList.Count(u => u.Role == UserRole.Trainer).ToString(), "#f59e0b", "bi-person-workspace"),
            ("Members", usersList.Count(u => u.Role == UserRole.Member).ToString(), "#22c55e", "bi-person-check-fill")
        })
        {
            <div class="col-6 col-md-3">
                <div class="p-3 rounded d-flex align-items-center gap-3"
                     style="background: #111111; border: 1px solid rgba(255,255,255,0.07);">
                    <div class="d-flex align-items-center justify-content-center rounded"
                         style="width: 42px; height: 42px; background: @stat.Item3 + '1a'; color: @stat.Item3; border: 1px solid @stat.Item3 + '33'; flex-shrink: 0;">
                        <i class="bi @stat.Item4" style="font-size: 1.2rem;"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-white" style="font-size: 1.4rem; line-height: 1.2; font-family: 'Bebas Neue', sans-serif;">@stat.Item2</div>
                        <div style="color: #6b7280; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">@stat.Item1</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- ─── Filters ─── -->
    <div class="p-3 rounded mb-3 d-flex flex-column flex-md-row align-items-md-center gap-3 anim-fade-up-d2"
         style="background: #111111; border: 1px solid rgba(255,255,255,0.07);">
        <div class="d-flex align-items-center flex-grow-1 rounded"
             style="background: #181818; border: 1px solid rgba(255,255,255,0.08); overflow: hidden;">
            <span class="px-3" style="color: #6b7280;"><i class="bi bi-search"></i></span>
            <input type="text" class="flex-grow-1 border-0 bg-transparent text-white py-2 pe-3"
                   style="outline: none; font-size: 0.88rem;" placeholder="Search by name or email..."
                   @bind="searchTerm" @bind:event="oninput" />
        </div>
        <select class="rounded py-2 px-3 border-0 text-white"
                style="background: #181818; border: 1px solid rgba(255,255,255,0.08) !important; font-size: 0.88rem; min-width: 150px; cursor: pointer;"
                @bind="selectedRoleFilter">
            <option value="All">All Roles</option>
            <option value="Admin">Admins</option>
            <option value="Trainer">Trainers</option>
            <option value="Member">Members</option>
        </select>
        <span style="color: #6b7280; font-size: 0.82rem; white-space: nowrap;">
            <span class="fw-bold text-white">@FilteredUsers.Count</span> found
        </span>
    </div>

    <!-- ─── Users Table ─── -->
    <div class="rounded overflow-hidden anim-fade-up-d3" style="background: #111111; border: 1px solid rgba(255,255,255,0.07);">
        <div class="table-responsive">
            <table class="table mb-0" style="--bs-table-bg: transparent; color: #e5e7eb;">
                <thead>
                    <tr style="border-bottom: 2px solid #f5c518;">
                        <th class="ps-4 py-3 fw-700 text-uppercase"
                            style="font-size: 0.7rem; letter-spacing: 1.5px; color: #6b7280; background: #161616;">User</th>
                        <th class="py-3 fw-700 text-uppercase"
                            style="font-size: 0.7rem; letter-spacing: 1.5px; color: #6b7280; background: #161616;">Role</th>
                        <th class="py-3 fw-700 text-uppercase"
                            style="font-size: 0.7rem; letter-spacing: 1.5px; color: #6b7280; background: #161616;">Phone</th>
                        <th class="py-3 fw-700 text-uppercase"
                            style="font-size: 0.7rem; letter-spacing: 1.5px; color: #6b7280; background: #161616;">Joined</th>
                        <th class="pe-4 py-3 text-end fw-700 text-uppercase"
                            style="font-size: 0.7rem; letter-spacing: 1.5px; color: #6b7280; background: #161616;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5" style="color: #4b5563;">
                                <div class="spinner-border spinner-border-sm me-2" style="color: #f5c518;"></div>
                                Loading users...
                            </td>
                        </tr>
                    }
                    else if (!FilteredUsers.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5" style="color: #4b5563;">
                                <i class="bi bi-people d-block mb-2" style="font-size: 2rem; color: #374151;"></i>
                                No matching users found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in FilteredUsers)
                        {
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); transition: background 0.15s;">
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="d-flex align-items-center justify-content-center fw-bold text-black rounded"
                                             style="width: 38px; height: 38px; background: #f5c518; font-size: 0.78rem; flex-shrink: 0;">
                                            @GetInitials(user.FullName)
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-white" style="font-size: 0.9rem;">@user.FullName</div>
                                            <div style="font-size: 0.78rem; color: #6b7280;">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <span class="px-2 py-1 rounded fw-600" style="font-size: 0.75rem; @GetRoleStyle(user.Role)">
                                        @user.Role
                                    </span>
                                </td>
                                <td class="py-3" style="color: #6b7280; font-size: 0.85rem;">
                                    @(user.PhoneNumber ?? "—")
                                </td>
                                <td class="py-3" style="color: #6b7280; font-size: 0.85rem;">
                                    @user.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td class="pe-4 py-3 text-end">
                                    <button class="btn btn-sm rounded d-inline-flex align-items-center gap-1"
                                            style="background: rgba(245,197,24,0.1); border: 1px solid rgba(245,197,24,0.3); color: #f5c518; font-size: 0.78rem;"
                                            title="View Profile" @onclick="() => ViewUserProfile(user.UserId)">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ─── Create User Modal ─── -->
@if (showCreateModal)
{
    <div class="modal fade show d-block anim-fade" tabindex="-1" style="background: rgba(0,0,0,0.8);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded text-white" style="background: #111111; border: 1px solid rgba(255,255,255,0.1) !important;">
                <div class="modal-header p-4" style="border-bottom: 1px solid rgba(255,255,255,0.07);">
                    <h5 class="modal-title fw-bold" style="font-size: 1.1rem; font-family: 'Bebas Neue', sans-serif; letter-spacing: 1px;">
                        <i class="bi bi-person-plus-fill me-2" style="color: #f5c518;"></i>CREATE USER ACCOUNT
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseCreateUserModal"></button>
                </div>
                <div class="modal-body p-4">
                    @if (createErrorMessage != null)
                    {
                        <div class="p-3 rounded mb-3" style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #ef4444; font-size: 0.85rem;">
                            @createErrorMessage
                        </div>
                    }
                    <div class="mb-3">
                        <label class="d-block mb-1" style="color: #9ca3af; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Full Name</label>
                        <input type="text" class="w-100 rounded py-2 px-3 border-0 text-white"
                               style="background: #181818; border: 1px solid rgba(255,255,255,0.1) !important; font-size: 0.88rem; outline: none;"
                               @bind="newUserModel.FullName" placeholder="e.g. John Doe" />
                    </div>
                    <div class="mb-3">
                        <label class="d-block mb-1" style="color: #9ca3af; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Email Address</label>
                        <input type="email" class="w-100 rounded py-2 px-3 border-0 text-white"
                               style="background: #181818; border: 1px solid rgba(255,255,255,0.1) !important; font-size: 0.88rem; outline: none;"
                               @bind="newUserModel.Email" placeholder="user@gymak.com" />
                    </div>
                    <div class="mb-3">
                        <label class="d-block mb-1" style="color: #9ca3af; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Role</label>
                        <select class="w-100 rounded py-2 px-3 text-white"
                                style="background: #181818; border: 1px solid rgba(255,255,255,0.1); font-size: 0.88rem; outline: none;"
                                @bind="newUserModel.Role">
                            <option value="@UserRole.Member">Member</option>
                            <option value="@UserRole.Trainer">Trainer</option>
                            <option value="@UserRole.Admin">Admin</option>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="d-block mb-1" style="color: #9ca3af; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">Initial Password</label>
                        <input type="password" class="w-100 rounded py-2 px-3 border-0 text-white"
                               style="background: #181818; border: 1px solid rgba(255,255,255,0.1) !important; font-size: 0.88rem; outline: none;"
                               @bind="newUserModel.Password" placeholder="••••••••" />
                    </div>
                </div>
                <div class="modal-footer p-3" style="border-top: 1px solid rgba(255,255,255,0.07);">
                    <button type="button" class="btn btn-sm rounded px-4"
                            style="background: transparent; border: 1px solid rgba(255,255,255,0.12); color: #9ca3af;"
                            @onclick="CloseCreateUserModal">Cancel</button>
                    <button type="button" class="btn btn-sm fw-bold rounded px-4"
                            style="background: #f5c518; color: #000; border: none; letter-spacing: 0.5px; text-transform: uppercase;"
                            @onclick="HandleCreateUser" disabled="@isCreatingUser">
                        @if (isCreatingUser)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Creating...</span>
                        }
                        else
                        {
                            <span>Create Account</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto> usersList = new();
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private string selectedRoleFilter = "All";

    private bool showCreateModal;
    private bool isCreatingUser;
    private string? createErrorMessage;
    private CreateUserModel newUserModel = new();

    private class CreateUserModel
    {
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public UserRole Role { get; set; } = UserRole.Member;
    }

    protected override async Task OnInitializedAsync() => await LoadUsers();

    private async Task LoadUsers()
    {
        isLoading = true;
        try
        {
            var admins = await UserService.GetUsersByRoleAsync(UserRole.Admin);
            var trainers = await UserService.GetUsersByRoleAsync(UserRole.Trainer);
            var members = await UserService.GetUsersByRoleAsync(UserRole.Member);
            usersList = admins.Concat(trainers).Concat(members).OrderByDescending(u => u.CreatedAt).ToList();
        }
        finally { isLoading = false; }
    }

    private List<UserDto> FilteredUsers => usersList.Where(u =>
        (selectedRoleFilter == "All" || u.Role.ToString() == selectedRoleFilter) &&
        (string.IsNullOrWhiteSpace(searchTerm) ||
         u.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
         u.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
    ).ToList();

    private void OpenCreateUserModal() { newUserModel = new(); createErrorMessage = null; showCreateModal = true; }
    private void CloseCreateUserModal() => showCreateModal = false;

    private async Task HandleCreateUser()
    {
        if (string.IsNullOrWhiteSpace(newUserModel.FullName) || string.IsNullOrWhiteSpace(newUserModel.Email) || string.IsNullOrWhiteSpace(newUserModel.Password))
        { createErrorMessage = "Please fill in all required fields."; return; }

        isCreatingUser = true; createErrorMessage = null;
        try
        {
            await UserService.CreateUserAsync(new CreateUserRequest(newUserModel.FullName, newUserModel.Email, newUserModel.Password, null, newUserModel.Role));
            showCreateModal = false;
            await LoadUsers();
        }
        catch (Exception ex) { createErrorMessage = ex.Message; }
        finally { isCreatingUser = false; }
    }

    private void ViewUserProfile(Guid userId) { }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "U";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return (parts[0][..1] + parts[^1][..1]).ToUpper();
    }

    private static string GetRoleStyle(UserRole role) => role switch
    {
        UserRole.Admin => "background: rgba(239,68,68,0.15); color: #ef4444;",
        UserRole.Trainer => "background: rgba(245,158,11,0.15); color: #f59e0b;",
        UserRole.Member => "background: rgba(34,197,94,0.15); color: #22c55e;",
        _ => "background: rgba(156,163,175,0.15); color: #9ca3af;"
    };
}
