@page "/forgot-password"
@layout Layout.AuthLayout
@using Gymak.Application.DTOs
@using Gymak.Application.Services
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Forgot Password - GYMAK</PageTitle>

<div class="forgot-wrapper d-flex align-items-center justify-content-center min-vh-100 py-5" style="background: radial-gradient(circle at top right, #1e293b, #0f172a);">
    <div class="card border-0 shadow-lg p-4 p-md-5 rounded-4 text-white" style="max-width: 440px; width: 100%; background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.1);">
        
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="brand-icon mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-warning bg-gradient text-dark" style="width: 60px; height: 60px; box-shadow: 0 0 20px rgba(245, 158, 11, 0.4);">
                <i class="bi bi-key-fill fs-2"></i>
            </div>
            <h3 class="fw-bold tracking-tight mb-1">Forgot Password?</h3>
            <p class="text-muted small">Enter your email address to receive a password reset code</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 rounded-3 small mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>@errorMessage</div>
            </div>
        }

        @if (isSuccess && generatedToken != null)
        {
            <div class="alert alert-success border-0 bg-success bg-opacity-20 text-success p-3 rounded-3 mb-4">
                <div class="fw-bold mb-1"><i class="bi bi-check-circle-fill me-2"></i>Reset Code Generated!</div>
                <div class="small mb-2 text-white-50">Your reset code is:</div>
                <div class="p-2 rounded bg-dark font-monospace fw-bold fs-5 text-center text-warning letter-spacing-2 select-all mb-3">
                    @generatedToken
                </div>
                <a href="@($"reset-password?email={Uri.EscapeDataString(email)}&token={Uri.EscapeDataString(generatedToken)}")" class="btn btn-warning w-100 fw-semibold">
                    Proceed to Reset Password <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        }
        else
        {
            <EditForm Model="this" OnValidSubmit="HandleForgotPassword" FormName="ForgotPasswordForm">
                <div class="mb-3">
                    <label for="email" class="form-label text-white-50 small fw-medium">Registered Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text border-0 bg-dark text-muted"><i class="bi bi-envelope"></i></span>
                        <input id="email" type="email" class="form-control bg-dark border-0 text-white shadow-none" placeholder="name@gymak.com" @bind="email" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-warning w-100 py-2.5 fw-semibold rounded-3 mt-3 d-flex align-items-center justify-content-center gap-2" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Generating Code...</span>
                    }
                    else
                    {
                        <i class="bi bi-send-fill"></i>
                        <span>Send Reset Code</span>
                    }
                </button>
            </EditForm>
        }

        <div class="text-center mt-4">
            <a href="login" class="text-muted text-decoration-none small"><i class="bi bi-arrow-left me-1"></i> Back to Login</a>
        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string? errorMessage;
    private string? generatedToken;
    private bool isSuccess;
    private bool isLoading;

    private async Task HandleForgotPassword()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var req = new ForgotPasswordRequest(email);
            var result = await AuthService.ForgotPasswordAsync(req);

            if (result.Succeeded)
            {
                isSuccess = true;
                generatedToken = result.ResetToken;
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Failed to request password reset.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
